{
  "name": "@bitfinex/bfx-report-express",
  "version": "4.0.0",
  "description": "Express server of reporting tool",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfinexcom/bfx-report-express.git"
  },
  "license": "Apache-2.0",
  "contributors": [
    "Vladimir Voronkov <vsvoronkov@gmail.com>",
    "Paolo Ardoino <paolo@btifinex.com>",
    "Ezequiel Wernicke <ezequiel.wernicke@bitfinex.com>"
  ],
  "keywords": [
    "bitfinex"
  ],
  "bugs": {
    "url": "https://github.com/bitfinexcom/bfx-report-express/issues"
  },
  "homepage": "https://github.com/bitfinexcom/bfx-report-express#readme",
  "dependencies": {
    "colors": "1.4.0",
    "config": "5.0.1",
    "cors": "2.8.6",
    "debug": "4.4.3",
    "express": "4.22.3",
    "grenache-nodejs-http": "^2.0.2",
    "grenache-nodejs-link": "^2.0.2",
    "grenache-nodejs-ws": "1.0.0",
    "morgan": "1.12.1",
    "winston": "3.19.0",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@bitfinex/bfx-svc-test-helper": "^2.0.2",
    "@bitfinex/lint-js": "^1.1.0",
    "chai": "6.3.0",
    "cross-env": "10.1.0",
    "mocha": "12.0.3",
    "nodemon": "3.1.14",
    "supertest": "7.3.2"
  },
  "overrides": {
    "mocha": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    },
    "nodemon": {
      "minimatch": "11.0.5"
    },
    "grenache-nodejs-ws": {
      "cbq": "1.0.0",
      "grenache-nodejs-base": "2.0.1",
      "grenache-nodejs-link": "2.0.2",
      "uuid": "11.1.1",
      "ws": "7.5.13"

    }
  },
  "nodemonConfig": {
    "verbose": true,
    "ignore": [
      "node_modules/",
      "logs/",
      ".git/",
      ".idea/",
      ".vscode/"
    ]
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development nodemon index.js",
    "test": "npm run lint && cross-env NODE_ENV=test mocha './test/**/*.spec.js' --config .mocharc.json",
    "lint": "bfx-lint-js",
    "lint:fix": "bfx-lint-js --fix"
  }
}
